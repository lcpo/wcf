+// WCF per-tensor header: rows(u32) cols(u32) n_blocks(u32) ndim(u8) ne2(u32)
+// WCF block: scale(f32) + ioff(i16) + ibits(u8) + n_packed(u32) + packed(n_packed bytes)
+// Packed codes are MSB-first: value = (code + ioff) / scale.
+//
+// load_wcf_tensor() unpacks file blocks (32x32 tiles, variable 1-4 bit codes)
+// into native GGML_TYPE_WCF blocks (32 values each, fixed 4-bit nibbles, ibits=4).
+// The repack is exact: code values and (scale, ioff) are preserved, only the
+// bit-packing changes. This keeps CPU vec_dot, CUDA dequantize and CUDA mmvq
+// kernels consistent (they all read 4-bit nibbles MSB-first).
+void llama_model_loader::load_wcf_tensor(struct ggml_tensor * cur, const llama_tensor_weight & w) const {
