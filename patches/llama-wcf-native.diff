+// WCF fused vec_dot: value = (code + ioff) / scale
+// WCF ibits=4 packing: MSB-first, code j in byte j/2 (even code = high nibble, odd = low nibble)
+// Block layout: scale(f32) ioff(i16) ibits(u8) qs[16] = 23 bytes
+// Thread mapping (qi=4, vdr=2 => 2 threads/block, kqs=iqs in {0,2}, each covers 16 codes):
+//   iqs=0: WCF bytes {0-3, 8-11}  x act {0-7, 16-23}
+//   iqs=2: WCF bytes {4-7, 12-15} x act {8-15, 24-31}
+// Validated against CPU dequantize_row_wcf (max abs err 0.000000).
+static __device__ __forceinline__ float vec_dot_wcf_q8_1(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_wcf * bwcf = (const block_wcf *) vbq + kbx;
+    const float scale = bwcf->scale;
+    const int16_t ioff = bwcf->ioff;
+    const float d8 = __low2float(bq8_1->ds);  // q8_1 activation scale
+
+    const uint8_t * wA = (const uint8_t *)bwcf->qs + 2 * iqs;       // 4 bytes: codes 8i..8i+7
+    const uint8_t * wB = (const uint8_t *)bwcf->qs + 2 * iqs + 8;   // 4 bytes: codes 8i+16..8i+23
+    const int8_t  * aA = (const int8_t  *)bq8_1->qs + 4 * iqs;      // 8 bytes: act 4i..4i+7
+    const int8_t  * aB = (const int8_t  *)bq8_1->qs + 4 * iqs + 16; // 8 bytes: act 4i+16..4i+23
+
+    int sumi = 0;  // sum code_j * a_j
+    int suma = 0;  // sum a_j
+
+    for (int b = 0; b < 4; b++) {
+        const int chi = (wA[b] >> 4) & 0xF;  // even code  (8i + 2b)
+        const int clo =  wA[b] & 0xF;        // odd  code  (8i + 2b + 1)
+        sumi += chi * (int)(aA[2*b]) + clo * (int)(aA[2*b+1]);
+        suma += (int)(aA[2*b]) + (int)(aA[2*b+1]);
+    }
+    for (int b = 0; b < 4; b++) {
+        const int chi = (wB[b] >> 4) & 0xF;  // even code  (8i+16 + 2b)
+        const int clo =  wB[b] & 0xF;        // odd  code  (8i+16 + 2b + 1)
+        sumi += chi * (int)(aB[2*b]) + clo * (int)(aB[2*b+1]);
+        suma += (int)(aB[2*b]) + (int)(aB[2*b+1]);
+    }
+
+    // value_j = (code_j + ioff)/scale ; activation = a*d8
+    // dot = d8/scale * (sum code_j*a_j + ioff*sum a_j)
+    return d8 * (float)(sumi + ioff * suma) / scale;
+}
 
