+// WCF (Weight Compression Format) quantization
+// Multiply weights by scale, round to int, pack with offset.
+void quantize_row_wcf_ref(const float * GGML_RESTRICT x, block_wcf * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_WCF == 0);
+    const int nb = k / QK_WCF;
+    const float scale = 100.0f;  // default scale (auto-selected in compressor)
+    for (int i = 0; i < nb; i++) {
+        y[i].scale = scale;
+        y[i].ibits = 3;
+        int min_val = INT_MAX, max_val = INT_MIN;
+        int codes[QK_WCF];
+        for (int j = 0; j < QK_WCF; j++) {
+            codes[j] = (int)roundf(x[i*QK_WCF + j] * scale);
+            if (codes[j] < min_val) min_val = codes[j];
+            if (codes[j] > max_val) max_val = codes[j];
+        }
+        y[i].ioff = (int16_t)min_val;
+        // Fixed 3-bit packing: clamp to [0, 7]
+        for (int j = 0; j < QK_WCF; j++) {
+            int val = codes[j] - min_val;
+            if (val < 0) val = 0;
+            if (val > 7) val = 7;
+            // 3 bits per value, MSB-first
+            int bitpos = j * 3;
+            for (int b = 0; b < 3; b++) {
+                int bit = (val >> (3-1-b)) & 1;
+                if (bit) y[i].qs[(bitpos + b)/8] |= (1 << (7 - (bitpos + b)%8));
+            }
+        }
+    }
+}
