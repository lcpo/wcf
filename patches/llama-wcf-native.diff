+// WCF (Weight Compression Format) parser
+// Reads .wcf files and creates a gguf_context with GGML_TYPE_WCF tensors.
+// Fills *params.ctx with a ggml_context containing all tensors (no_alloc).
+struct gguf_context * gguf_init_from_wcf_file(const char * fname, struct gguf_init_params params) {
+    GGML_LOG_INFO("%s: WCF parser started\n", __func__);
+    FILE * file = fopen(fname, "rb");
+    if (!file) {
+        GGML_LOG_ERROR("%s: failed to open %s\n", __func__, fname);
+        return nullptr;
+    }
+
+    struct gguf_context * ctx = gguf_init_empty();
+    if (!ctx) { fclose(file); return nullptr; }
+
+    // Read WCFH header (metadata)
+    {
+        char hmagic[4];
+        if (fread(hmagic, 1, 4, file) == 4 && memcmp(hmagic, "WCFH", 4) == 0) {
+            uint8_t hversion;
+            uint16_t n_fields;
+            if (fread(&hversion, 1, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+            if (fread(&n_fields, 2, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+            for (int i = 0; i < n_fields; i++) {
+                uint16_t kb;
+                if (fread(&kb, 2, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                char key[256];
+                if (kb >= 256) { gguf_free(ctx); fclose(file); return nullptr; }
+                if (fread(key, 1, kb, file) != kb) { gguf_free(ctx); fclose(file); return nullptr; }
+                key[kb] = 0;
+                uint8_t vtype;
+                if (fread(&vtype, 1, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                if (vtype == 0) { // string
+                    uint32_t vb;
+                    if (fread(&vb, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                    char * val = (char *) malloc(vb + 1);
+                    if (fread(val, 1, vb, file) != vb) { free(val); gguf_free(ctx); fclose(file); return nullptr; }
+                    val[vb] = 0;
+                    gguf_set_val_str(ctx, key, val);
+                    free(val);
+                } else if (vtype == 1) { // int64
+                    int64_t val;
+                    if (fread(&val, 8, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                    gguf_set_val_i64(ctx, key, val);
+                } else if (vtype == 2) { // double
+                    double val;
+                    if (fread(&val, 8, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                    gguf_set_val_f64(ctx, key, val);
+                } else if (vtype == 3) { // bool
+                    uint8_t val;
+                    if (fread(&val, 1, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                    gguf_set_val_bool(ctx, key, val != 0);
+                } else if (vtype == 6) { // uint32
+                    uint32_t val;
+                    if (fread(&val, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                    gguf_set_val_u32(ctx, key, val);
+                } else if (vtype == 7) { // float32
+                    float val;
+                    if (fread(&val, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                    gguf_set_val_f32(ctx, key, val);
+                } else if (vtype == 8) { // int32
+                    int32_t val;
+                    if (fread(&val, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                    gguf_set_val_i32(ctx, key, val);
+                } else if (vtype == 4) { // string array
+                    uint32_t n;
+                    if (fread(&n, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                    const char ** arr = (const char **) malloc(n * sizeof(char*));
+                    for (uint32_t j = 0; j < n; j++) {
+                        uint32_t sb;
+                        if (fread(&sb, 4, 1, file) != 1) { free(arr); gguf_free(ctx); fclose(file); return nullptr; }
+                        char * s = (char *) malloc(sb + 1);
+                        if (fread(s, 1, sb, file) != sb) { free(s); free(arr); gguf_free(ctx); fclose(file); return nullptr; }
+                        s[sb] = 0;
+                        arr[j] = s;
+                    }
+                    gguf_set_arr_str(ctx, key, arr, n);
+                    for (uint32_t j = 0; j < n; j++) free((void*)arr[j]);
+                    free(arr);
+                } else if (vtype == 5) { // int32 array
+                    uint32_t n;
+                    if (fread(&n, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                    int32_t * arr = (int32_t *) malloc(n * sizeof(int32_t));
+                    if (fread(arr, 4, n, file) != n) { free(arr); gguf_free(ctx); fclose(file); return nullptr; }
+                    gguf_set_arr_data(ctx, key, GGUF_TYPE_INT32, arr, n);
+                    free(arr);
+                }
+            }
+        } else {
+            if (fseek(file, 0, SEEK_SET) != 0) { gguf_free(ctx); fclose(file); return nullptr; }
+        }
+    }
+
+    // First pass: count tensors (read headers, skip data)
+    int n_tensors_total = 0;
+    {
+        long hdr_end = ftell(file);
+        while (true) {
+            char bmagic[4];
+            if (fread(bmagic, 1, 4, file) != 4) break;
+            if (memcmp(bmagic, "WCFI", 4) != 0) break;
+            uint8_t bversion;
+            if (fread(&bversion, 1, 1, file) != 1) break;
+            uint32_t bn_tensors;
+            if (fread(&bn_tensors, 4, 1, file) != 1) break;
+            for (uint32_t t = 0; t < bn_tensors; t++) {
+                uint16_t name_len;
+                if (fread(&name_len, 2, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                fseek(file, name_len, SEEK_CUR);
+                uint32_t rows, cols;
+                if (fread(&rows, 4, 1, file) != 1 || fread(&cols, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                uint32_t n_blocks;
+                if (fread(&n_blocks, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                uint8_t ndim = 2; uint32_t ne2 = 1;
+                if (fread(&ndim, 1, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                if (fread(&ne2, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+                if (n_blocks == 0) {
+                    // Raw F32 data, skip rows*cols*4 bytes
+                    if (fseek(file, rows * cols * sizeof(float), SEEK_CUR) != 0) { gguf_free(ctx); fclose(file); return nullptr; }
+                } else {
+                for (uint32_t b = 0; b < n_blocks; b++) {
+                    float scale; int16_t ioff; uint8_t ibits; uint32_t n_packed;
+                    if (fread(&scale, 4, 1, file) != 1 || fread(&ioff, 2, 1, file) != 1 ||
+                        fread(&ibits, 1, 1, file) != 1 || fread(&n_packed, 4, 1, file) != 1) {
+                        gguf_free(ctx); fclose(file); return nullptr;
+                    }
+                    fseek(file, n_packed, SEEK_CUR);
+                }
+                }
+                n_tensors_total++;
+            }
+        }
+        fseek(file, hdr_end, SEEK_SET);
+    }
+
+    // Create ggml_context for all tensors (no_alloc)
+    struct ggml_context * ctx_data = nullptr;
+    if (params.ctx != nullptr) {
+        const size_t mem_size = (n_tensors_total + 1) * ggml_tensor_overhead();
+        struct ggml_init_params pdata = {
+            /*.mem_size   = */ mem_size,
+            /*.mem_buffer = */ nullptr,
+            /*.no_alloc   = */ true,
+        };
+        ctx_data = ggml_init(pdata);
+        if (!ctx_data) { gguf_free(ctx); fclose(file); return nullptr; }
+        *params.ctx = ctx_data;
+    }
+
+    // Second pass: read tensors, create in ctx_data, add to gguf ctx
+    int n_created = 0;
+    while (true) {
+        char bmagic[4];
+        if (fread(bmagic, 1, 4, file) != 4) break;
+        if (memcmp(bmagic, "WCFI", 4) != 0) { GGML_LOG_ERROR("%s: invalid block magic\n", __func__); break; }
+        uint8_t bversion;
+        if (fread(&bversion, 1, 1, file) != 1) break;
+        uint32_t bn_tensors;
+        if (fread(&bn_tensors, 4, 1, file) != 1) break;
+
+        for (uint32_t t = 0; t < bn_tensors; t++) {
+            uint16_t name_len;
+            if (fread(&name_len, 2, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+            std::vector<char> name_buf(name_len + 1);
+            if (fread(name_buf.data(), 1, name_len, file) != name_len) { gguf_free(ctx); fclose(file); return nullptr; }
+            name_buf[name_len] = 0;
+            std::string name(name_buf.data());
+
+            uint32_t rows, cols;
+            if (fread(&rows, 4, 1, file) != 1 || fread(&cols, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+            uint32_t n_blocks;
+            if (fread(&n_blocks, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+            uint8_t ndim = 2; uint32_t ne2 = 1;
+            if (fread(&ndim, 1, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+            if (fread(&ne2, 4, 1, file) != 1) { gguf_free(ctx); fclose(file); return nullptr; }
+
+            // Calculate data offset for this tensor
+            long data_offset = ftell(file);
+
+            // Create tensor in ctx_data (if available)
+            if (ctx_data) {
+                int64_t ne[GGML_MAX_DIMS] = { (int64_t)cols, (int64_t)rows, (int64_t)ne2, 1 };
+                // WCF tensors: native GGML_TYPE_WCF (per-block scale+offset+ibits).
+                // Buffers are allocated at WCF size (~15GB) not F32 size (~138GB).
+                // Small tensors (n_blocks==0) stay F32 (raw data).
+                enum ggml_type tensor_type;
+                if (n_blocks > 0) {
+                    tensor_type = GGML_TYPE_WCF;
+                } else {
+                    tensor_type = GGML_TYPE_F32;
+                }
+                struct ggml_tensor * tensor = ggml_new_tensor(ctx_data, tensor_type, ndim, ne);
+                if (!tensor) { gguf_free(ctx); fclose(file); return nullptr; }
+                ggml_set_name(tensor, name.c_str());
+                gguf_add_tensor(ctx, tensor);
+
+                // Set data offset for this tensor
+                int64_t tensor_id = gguf_find_tensor(ctx, name.c_str());
+                if (tensor_id >= 0) {
+                    ctx->info[tensor_id].offset = data_offset;
+                }
+            }
+
+            // Skip tensor data
+            if (n_blocks == 0) {
+                // 1D tensor: raw F32 data
+                if (fseek(file, rows * cols * sizeof(float), SEEK_CUR) != 0) break;
+            } else {
+            for (uint32_t b = 0; b < n_blocks; b++) {
+                float scale; int16_t ioff; uint8_t ibits; uint32_t n_packed;
+                if (fread(&scale, 4, 1, file) != 1 || fread(&ioff, 2, 1, file) != 1 ||
+                    fread(&ibits, 1, 1, file) != 1 || fread(&n_packed, 4, 1, file) != 1) {
+                    gguf_free(ctx); fclose(file); return nullptr;
+                }
+                fseek(file, n_packed, SEEK_CUR);
+            }
+            }
+            n_created++;
+        }
+    }
+
+    GGML_LOG_INFO("%s: loaded %d tensors\n", __func__, n_created);
+    fclose(file);
+    return ctx;
+}
