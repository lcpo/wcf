+// WCF dequantize (qk=32, qr=2): v.x=val@j=iqs, v.y=val@j=iqs+16
+// ibits=4 fast path: code j in byte j/2, even j = high nibble, odd j = low nibble
+static __device__ __forceinline__ void dequantize_wcf(const void * vx, const int64_t ib, const int iqs, float2 & v) {
+    const block_wcf * x = (const block_wcf *) vx;
+    const float scale = x[ib].scale;
+    const int16_t ioff = x[ib].ioff;
+    const int ibits = x[ib].ibits > 0 ? x[ib].ibits : 3;
+    const int j0 = iqs, j1 = iqs + 16;
+    int v0, v1;
+    if (ibits == 4) {
+        v0 = (j0 & 1) ? (x[ib].qs[j0 >> 1] & 0xF) : (x[ib].qs[j0 >> 1] >> 4);
+        v1 = (j1 & 1) ? (x[ib].qs[j1 >> 1] & 0xF) : (x[ib].qs[j1 >> 1] >> 4);
+    } else {
+        v0 = 0; v1 = 0;
+        for (int b = 0; b < ibits; b++) {
+            int bp0 = j0 * ibits + b;
+            int bp1 = j1 * ibits + b;
+            v0 = (v0 << 1) | ((x[ib].qs[bp0 / 8] >> (7 - bp0 % 8)) & 1);
+            v1 = (v1 << 1) | ((x[ib].qs[bp1 / 8] >> (7 - bp1 % 8)) & 1);
+        }
+    }
+    v.x = (float)(v0 + ioff) / scale;
+    v.y = (float)(v1 + ioff) / scale;
+}
