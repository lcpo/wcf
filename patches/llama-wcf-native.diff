+// WCF (Weight Compression Format) quantization
+// Per-block auto scale + integer offset + variable 1-4 bit codes.
+// value = (code + ioff) / scale. Native layout: fixed 4-bit nibbles (ibits=4),
+// MSB-first. File blocks (variable ibits 1-4) are repacked at load time.
+#define QK_WCF 32
+#define QR_WCF 2
+#define QI_WCF (QK_WCF / (4 * QR_WCF))
+#define WCF_BITS_MAX 4
+typedef struct {
+    float scale;    // integer scaling factor (weight = code / scale)
+    int16_t ioff;   // offset for int codes
+    uint8_t ibits;  // bits per code (1-8)
+    uint8_t qs[QK_WCF * WCF_BITS_MAX / 8];  // packed int codes (max 32 bytes)
+} __attribute__((packed)) block_wcf;
+static_assert(sizeof(block_wcf) == sizeof(float) + sizeof(int16_t) + sizeof(uint8_t) + QK_WCF * WCF_BITS_MAX / 8, "wrong wcf block size/padding");
 
 // 5-bit quantization
