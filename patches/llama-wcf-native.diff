+        file->read_raw(raw_host_buf.data(), raw_size);
+        if (cur->buffer && !ggml_backend_buffer_is_host(cur->buffer)) {
+            ggml_backend_tensor_set(cur, raw_host_buf.data(), 0, raw_size);
