+    for (int i = 0; i < nb; i++) {
+        const float scale = x[i].scale;
+        const int16_t ioff = x[i].ioff;
+        const int ibits = x[i].ibits > 0 ? x[i].ibits : 3;
+        for (int j = 0; j < QK_WCF; j++) {
+            // Read ibits bits, MSB-first
+            int bitpos = j * ibits;
+            int val = 0;
+            for (int b = 0; b < ibits; b++) {
